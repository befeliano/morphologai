# MorphologAI — yerel geliştirme için Supabase bağlantısı
# Bu dosyayı ".env.local" adıyla kopyalayıp değerleri doldurun (git'e gönderilmez).
# Değerler: Supabase paneli → Project Settings → API (Data API / API Keys)
#
# Boş bırakılırsa uygulama yerel modda (bu tarayıcıdaki veritabanı) çalışır.
# Vercel'de aynı iki değişkeni Project → Settings → Environment Variables bölümüne ekleyin.

SUPABASE_URL=https://PROJE-KIMLIGI.supabase.co
SUPABASE_ANON_KEY=eyJ...  # "anon public" ya da "publishable" anahtar — ASLA service_role/secret değil
